@page "/books_mudtable"
@using MyAbpProject.Permissions
@using Volo.Abp.Application.Dtos
@using MyAbpProject.Books
@using MyAbpProject.Localization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(MyAbpProjectPermissions.Books.Default)]

@inherits MyAbpProject.Blazor.MyAbpProjectComponentBase
@inject IBookAppService BookAppService

@* Inject 2 dịch vụ của MudBlazor để hiển thị Hộp thoại và Thông báo *@
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudCard Elevation="3" Class="m-4">
    <MudCardContent>
        <MudTable ServerData="@ServerReload"
                  T="BookDto"
                  @ref="_table"
                  Dense="false"
                  Hover="true">
            
            @* Thanh công cụ phía trên bảng chứa nút THÊM *@
            <ToolBarContent>
                <MudText Typo="Typo.h5" Color="MudBlazor.Color.Primary"><b>@L["Books"]</b></MudText>
                <MudSpacer />
                @if (HasCreatePermission)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="MudBlazor.Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateDialogAsync">
                        @L["NewBook"]
                    </MudButton>
                }
            </ToolBarContent>

            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="Name" T="BookDto">@L["Name"]</MudTableSortLabel></MudTh>
                <MudTh>@L["Type"]</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PublishDate" T="BookDto">@L["PublishDate"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Price" T="BookDto">@L["Price"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="CreationTime" T="BookDto">@L["CreationTime"]</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:center">Thao tác</MudTh> @* Cột mới *@
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Name"]">@context.Name</MudTd>
                <MudTd DataLabel="@L["Type"]">@L[$"Enum:BookType.{context.Type}"]</MudTd>
                <MudTd DataLabel="@L["PublishDate"]">@context.PublishDate.ToShortDateString()</MudTd>
                <MudTd DataLabel="@L["Price"]">@context.Price</MudTd>
                <MudTd DataLabel="@L["CreationTime"]">@context.CreationTime.ToLongDateString()</MudTd>
                
                @* Các nút SỬA và XÓA cho từng dòng *@
                <MudTd DataLabel="Thao tác" Style="text-align:center">
                    @if (HasUpdatePermission)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="MudBlazor.Color.Warning"
                                       Size="MudBlazor.Size.Small"
                                       OnClick="@(() => OpenEditDialogAsync(context))" />
                    }
                    @if (HasDeletePermission)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="MudBlazor.Color.Error"
                                       Size="MudBlazor.Size.Small"
                                       OnClick="@(() => DeleteBookAsync(context))" />
                    }
                </MudTd>
            </RowTemplate>
            
            <NoRecordsContent><MudText>Không tìm thấy dữ liệu nào.</MudText></NoRecordsContent>
            <LoadingContent><MudText>Đang tải dữ liệu...</MudText></LoadingContent>
            <PagerContent><MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" /></PagerContent>
        </MudTable>
    </MudCardContent>
</MudCard>