@page "/books_muddatagrid"
@using MyAbpProject.Permissions
@using System.Threading
@using Volo.Abp.Application.Dtos
@using MyAbpProject.Books
@using MyAbpProject.Localization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(MyAbpProjectPermissions.Books.Default)]

@inherits MyAbpProject.Blazor.MyAbpProjectComponentBase
@inject IBookAppService BookAppService

@* Inject 2 dịch vụ của MudBlazor để hiển thị Hộp thoại và Thông báo *@
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudCard Elevation="3" Class="m-4">
    <MudCardContent>
        <MudDataGrid ServerData="@ServerReload"
                     T="BookDto"
                     @ref="_dataGrid"
                     Dense="false"
                     Hover="true">
            
            @* Thanh công cụ phía trên bảng chứa nút THÊM *@
            <ToolBarContent>
                <MudText Typo="Typo.h5" Color="MudBlazor.Color.Primary"><b>@L["Books"]</b></MudText>
                <MudSpacer />
                @if (HasCreatePermission)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="MudBlazor.Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateDialogAsync">
                        @L["NewBook"]
                    </MudButton>
                }
            </ToolBarContent>

            <Columns>
                <PropertyColumn Property="x => x.Name" Title="@L["Name"]" />
                
                <TemplateColumn Title="@L["Type"]">
                    <CellTemplate>
                        @L[$"Enum:BookType.{context.Item.Type}"]
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="@L["PublishDate"]" SortBy="x => x.PublishDate">
                    <CellTemplate>
                        @context.Item.PublishDate.ToShortDateString()
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.Price" Title="@L["Price"]" />

                <TemplateColumn Title="@L["CreationTime"]" SortBy="x => x.CreationTime">
                    <CellTemplate>
                        @context.Item.CreationTime.ToLongDateString()
                    </CellTemplate>
                </TemplateColumn>

                @* Các nút SỬA và XÓA cho từng dòng *@
                <TemplateColumn Title="Thao tác" CellClass="text-center" HeaderClass="text-center" Sortable="false">
                    <CellTemplate>
                        @if (HasUpdatePermission)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="MudBlazor.Color.Warning"
                                           Size="MudBlazor.Size.Small"
                                           OnClick="@(() => OpenEditDialogAsync(context.Item))" />
                        }
                        @if (HasDeletePermission)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="MudBlazor.Color.Error"
                                           Size="MudBlazor.Size.Small"
                                           OnClick="@(() => DeleteBookAsync(context.Item))" />
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            
            <NoRecordsContent><MudText>Không tìm thấy dữ liệu nào.</MudText></NoRecordsContent>
            <LoadingContent><MudText>Đang tải dữ liệu...</MudText></LoadingContent>
            <PagerContent><MudDataGridPager PageSizeOptions="new int[] { 10, 25, 50 }" /></PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>
