@page "/books_basic"
@using MyAbpProject.Permissions
@using System.Threading
@using Volo.Abp.Application.Dtos
@using MyAbpProject.Books
@using MyAbpProject.Localization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(MyAbpProjectPermissions.Books.Default)]

@* Kế thừa từ lớp cơ sở của dự án thay vì lớp có sẵn của Blazorise *@
@inherits MyAbpProject.Blazor.MyAbpProjectComponentBase
@inject IBookAppService BookAppService

<MudCard Elevation="3" Class="m-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5" Color="MudBlazor.Color.Primary"><b>@L["Books"]</b></MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudTable ServerData="@ServerReload"
                  T="BookDto"
                  Dense="true"
                  Hover="true"
                  Elevation="0">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="Name" T="BookDto">@L["Name"]</MudTableSortLabel></MudTh>
                <MudTh>@L["Type"]</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PublishDate" T="BookDto">@L["PublishDate"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Price" T="BookDto">@L["Price"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="CreationTime" T="BookDto">@L["CreationTime"]</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Name"]">@context.Name</MudTd>
                <MudTd DataLabel="@L["Type"]">@L[$"Enum:BookType.{context.Type}"]</MudTd>
                <MudTd DataLabel="@L["PublishDate"]">@context.PublishDate.ToShortDateString()</MudTd>
                <MudTd DataLabel="@L["Price"]">@context.Price</MudTd>
                <MudTd DataLabel="@L["CreationTime"]">@context.CreationTime.ToLongDateString()</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Không tìm thấy dữ liệu nào.</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>Đang tải dữ liệu...</MudText>
            </LoadingContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
            </PagerContent>
        </MudTable>
    </MudCardContent>
</MudCard>

